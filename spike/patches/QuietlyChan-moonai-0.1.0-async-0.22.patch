 /// Return the default native transport as an injectable trait object.
 pub fn native_http_transport() -> &HttpTransport {
   NativeHttpTransport::new()
+}
+
+///|
+/// PATCH(async 0.22): @http keys headers case-insensitively.
+fn ci_headers(
+  headers : Map[String, String],
+) -> Map[@http.CaseInsensitiveString, String] {
+  let out : Map[@http.CaseInsensitiveString, String] = Map([])
+  for name, value in headers {
+    out[@http.CaseInsensitiveString(name)] = value
+  }
+  out
+}
+
+///|
+/// PATCH(async 0.22): back to plain string keys.
+fn plain_headers(
+  headers : Map[@http.CaseInsensitiveString, String],
+) -> Map[String, String] {
+  let out : Map[String, String] = Map([])
+  for name, value in headers {
+    out[name.to_string()] = value
+  }
+  out
 }
