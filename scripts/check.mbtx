// Full verification gate: type check every target, run tests on both targets
// the shared core ships to, and discharge proofs.
//
//   moon run scripts/check.mbtx
import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
}

async fn main {
  println("==> scripts/check-dockerfile.sh")
  let code = @shell.Cmd("scripts/check-dockerfile.sh", []).status()
  if code != 0 {
    fail("scripts/check-dockerfile.sh exited with \{code}")
  }
  let steps : Array[Array[String]] = [
    ["fmt", "--check"],
    ["check", "--target", "all", "--deny-warn"],
    ["test", "--target", "js"],
    ["test", "--target", "native"],
    ["prove"],
  ]
  for args in steps {
    println("==> moon \{args.join(" ")}")
    let code = @shell.Cmd("moon", args).status()
    if code != 0 {
      fail("moon \{args.join(" ")} exited with \{code}")
    }
  }
}
